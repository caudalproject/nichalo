NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
GEMINI_API_KEY=
APIFY_API_KEY=
MERCADOPAGO_ACCESS_TOKEN=
# Secret del HMAC de fingerprinting anti-fraude (Hallazgo 1). Cualquier string
# largo y random sirve — no es un secret compartido con nada externo.
FINGERPRINT_SECRET=

# --- Mail (Resend) ---------------------------------------------------------
# Ya estaba en uso desde junio (bienvenida y "tu analisis esta listo") pero no
# figuraba aca. El mail del seguimiento semanal tambien sale por esta key.
RESEND_API_KEY=
# Base de los links de los mails. Sin esto se usa https://nichalo.com.
SITE_URL=

# --- Cron del seguimiento (TAB 5.1) ----------------------------------------
# EL CRON NACE APAGADO. Cada corrida paga un scrape de Apify (~$119 ARS) POR
# NICHO VIGILADO, se mande mail o no. Sin esta variable el cron corre, no
# encuentra nada que hacer y termina.
#   off    (default) no encola nada
#   prueba solo los nichos de los mails de SEGUIMIENTO_CRON_EMAILS
#   on     todos los nichos activos, dentro del cupo de cada plan
SEGUIMIENTO_CRON=off
# Lista separada por comas. Solo se usa con SEGUIMIENTO_CRON=prueba.
SEGUIMIENTO_CRON_EMAILS=
# Techo duro de scrapes por corrida, independiente de los cupos por plan. Es la
# red contra un bug en el conteo: pase lo que pase, una corrida no puede costar
# mas que este numero por $119 ARS. Default 25.
SEGUIMIENTO_CRON_MAX=25
# Dias minimos entre dos mediciones del mismo nicho (default 6). Solo se baja
# para verificar el mail end-to-end, que necesita dos mediciones: sin medicion
# anterior no hay delta y no se manda nada. Bajarlo no destraba gasto extra (el
# cupo por plan y SEGUIMIENTO_CRON_MAX siguen mandando), pero deja de proteger
# contra re-medir un nicho que el usuario acaba de medir a mano.
SEGUIMIENTO_CRON_DIAS_MIN=6
